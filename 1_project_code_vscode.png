n class="ͼo">&gt;</span><br><br><span>            </span><span class="ͼo">&lt;h1</span><span> </span><span class="ͼn">class</span><span class="ͼg">=</span><span class="ͼk">"text-center mb-4"</span><span class="ͼo">&gt;</span><br><span>                URL Shortener Application</span><br><span>            </span><span class="ͼo">&lt;/h1&gt;</span><br><br><span>            </span><span class="ͼo">&lt;form</span><span> </span><span class="ͼn">method</span><span class="ͼg">=</span><span class="ͼk">"POST"</span><span class="ͼo">&gt;</span><br><br><span>                </span><span class="ͼo">&lt;div</span><span> </span><span class="ͼn">class</span><span class="ͼg">=</span><span class="ͼk">"mb-3"</span><span class="ͼo">&gt;</span><br><br><span>                    </span><span class="ͼo">&lt;input</span><br><span>                        </span><span class="ͼn">type</span><span class="ͼg">=</span><span class="ͼk">"text"</span><br><span>                        </span><span class="ͼn">name</span><span class="ͼg">=</span><span class="ͼk">"long_url"</span><br><span>                        </span><span class="ͼn">class</span><span class="ͼg">=</span><span class="ͼk">"form-control"</span><br><span>                        </span><span class="ͼn">placeholder</span><span class="ͼg">=</span><span class="ͼk">"Enter your long URL"</span><br><span>                        </span><span class="ͼn">required</span><br><span>                    </span><span class="ͼo">&gt;</span><br><br><span>                </span><span class="ͼo">&lt;/div&gt;</span><br><br><span>                </span><span class="ͼo">&lt;div</span><span> </span><span class="ͼn">class</span><span class="ͼg">=</span><span class="ͼk">"d-grid"</span><span class="ͼo">&gt;</span><br><br><span>                    </span><span class="ͼo">&lt;button</span><span> </span><span class="ͼn">type</span><span class="ͼg">=</span><span class="ͼk">"submit"</span><span> </span><span class="ͼn">class</span><span class="ͼg">=</span><span class="ͼk">"btn btn-primary"</span><span class="ͼo">&gt;</span><br><span>                        Shorten URL</span><br><span>                    </span><span class="ͼo">&lt;/button&gt;</span><br><br><span>                </span><span class="ͼo">&lt;/div&gt;</span><br><br><span>            </span><span class="ͼo">&lt;/form&gt;</span><br><br><span>            {% if short_url %}</span><br><br><span>            </span><span class="ͼo">&lt;div</span><span> </span><span class="ͼn">class</span><span class="ͼg">=</span><span class="ͼk">"alert alert-success mt-4"</span><span class="ͼo">&gt;</span><br><br><span>                </span><span class="ͼo">&lt;h5&gt;</span><span>Short URL Generated:</span><span class="ͼo">&lt;/h5&gt;</span><br><br><span>                </span><span class="ͼo">&lt;a</span><span> </span><span class="ͼn">href</span><span class="ͼg">=</span><span class="ͼk">"{{ short_url }}"</span><span> </span><span class="ͼn">target</span><span class="ͼg">=</span><span class="ͼk">"_blank"</span><span class="ͼo">&gt;</span><br><span>                    {{ short_url }}</span><br><span>                </span><span class="ͼo">&lt;/a&gt;</span><br><br><span>            </span><span class="ͼo">&lt;/div&gt;</span><br><br><span>            {% endif %}</span><br><br><span>        </span><span class="ͼo">&lt;/div&gt;</span><br><br><span>    </span><span class="ͼo">&lt;/div&gt;</span><br><br><span class="ͼo">&lt;/body&gt;</span><br><br><span class="ͼo">&lt;/html&gt;</span></code></pre></div></div></div></div></div></div></div></div></div><div class=""><div class="" style="width: 100%; transform: none;"></div></div></div></div></div></pre>
