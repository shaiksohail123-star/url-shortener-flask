<h1 data-start="613" data-end="631" data-section-id="1k4syb6">Then Login Again</h1>
<p data-start="633" data-end="637">Use:</p>
<div class="TyagGW_tableContainer"><div tabindex="-1" class="group TyagGW_tableWrapper flex flex-col-reverse w-fit"><table data-start="639" data-end="765" class="w-fit min-w-(--thread-content-width)"><thead data-start="639" data-end="656"><tr data-start="639" data-end="656"><th data-start="639" data-end="647" data-col-size="sm" class="last:pe-10">Field</th><th data-start="647" data-end="656" data-col-size="sm" class="last:pe-10">Value</th></tr></thead><tbody data-start="667" data-end="765"><tr data-start="667" data-end="698"><td data-start="667" data-end="680" data-col-size="sm">Account ID</td><td data-col-size="sm" data-start="680" data-end="698"><code data-start="682" data-end="696">562590527364</code></td></tr><tr data-start="699" data-end="735"><td data-start="699" data-end="710" data-col-size="sm">Username</td><td data-col-size="sm" data-start="710" data-end="735"><code data-start="712" data-end="733">enterprise-rag-user</code></td></tr><tr data-start="736" data-end="765"><td data-start="736" data-end="747" data-col-size="sm">Password</td><td data-col-size="sm" data-start="747" data-end="765"><code data-start="749" data-end="763">Sohail@12345</code></td></tr></tbody></table><div class="relative h-0 self-end select-none"><div class="absolute end-0 flex items-end" style="height: 32.7969px;"><span class="" data-state="closed"><button aria-label="Copy table" class="hover:bg-token-bg-tertiary text-token-text-secondary relative z-10 my-1 rounded-sm p-1 transition-opacity group-[:not(:hover):not(:focus-within)]:pointer-events-none group-[:not(:hover):not(:focus-within)]:opacity-0"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon"><use href="/cdn/assets/sprites-core-45720d6d.svg#ce3544" fill="currentColor"></use></svg></button></span></div></div></div></div>
