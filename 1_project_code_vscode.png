<p data-start="679" data-end="730">and Bedrock will answer from your uploaded files 🚀</p>
<hr data-start="732" data-end="735">
<h2 data-start="737" data-end="749" data-section-id="i6rev7">Important</h2>
<p data-start="751" data-end="758">Do NOT:</p>
<ul data-start="759" data-end="814">
<li data-start="759" data-end="773" data-section-id="kd6xo1">
<p data-start="761" data-end="773">delete again</p>
</li>
<li data-start="774" data-end="790" data-section-id="vrak57">
