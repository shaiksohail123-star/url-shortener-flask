<hr data-start="1166" data-end="1169">
<h1 data-start="1171" data-end="1194" data-section-id="mbjeyn">Step 9 — Vector Store</h1>
<p data-start="1196" data-end="1226">AWS may automatically suggest:</p>
<ul data-start="1227" data-end="1250">
<li data-start="1227" data-end="1250" data-section-id="752n0e">
<p data-start="1229" data-end="1250">OpenSearch Serverless</p>
</li>
</ul>
<p data-start="1252" data-end="1286">Choose default recommended option.</p>
<hr data-start="1288" data-end="1291">
<h1 data-start="1293" data-end="1307" data-section-id="1b4gpnz">IMPORTANT ⚠️</h1>
