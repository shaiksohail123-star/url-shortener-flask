class="-ms-0.5 icon"><use href="/cdn/assets/sprites-core-45720d6d.svg#6ef7a4" fill="currentColor"></use></svg>Run</div></button></div></div></div><div class="pointer-events-none absolute inset-x-4 top-12 bottom-4"><div class="pointer-events-none sticky z-40 shrink-0 z-1!" style="top: calc(calc(var(--sticky-padding-top) + 48px) - 1px * 3); margin-bottom: calc(-4px); height: calc(4px); mask-image: linear-gradient(transparent 25%, white 75%);"><div class="sticky bg-token-border-light" style="top: calc(var(--sticky-padding-top) + 48px); height: 1px;"></div></div></div><div class="relative"><div class="" style="transform: none;"><div class="relative z-0 flex max-w-full"><div id="code-block-viewer" dir="ltr" class="q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr"><div class="cm-scroller"><pre class="cm-content q9tKkq_readonly m-0"><code><span class="ͼg">from</span><span> </span><span class="ͼm">flask</span><span> </span><span class="ͼg">import</span><span> </span><span class="ͼm">Flask</span><span>, </span><span class="ͼm">render_template</span><span>, </span><span class="ͼm">request</span><br><span class="ͼg">import</span><span> </span><span class="ͼm">random</span><br><span class="ͼg">import</span><span> </span><span class="ͼm">string</span><br><br><span class="ͼm">app</span><span> </span><span class="ͼg">=</span><span> </span><span class="ͼm">Flask</span><span>(</span><span class="ͼm">__name__</span><span>)</span><br><br><span class="ͼm">url_mapping</span><span> </span><span class="ͼg">=</span><span> {}</span><br><br><span class="ͼf">@</span><span class="ͼm">app</span><span class="ͼg">.</span><span class="ͼm">route</span><span>(</span><span class="ͼk">'/'</span><span>, </span><span class="ͼm">methods</span><span class="ͼg">=</span><span>[</span><span class="ͼk">'GET'</span><span>, </span><span class="ͼk">'POST'</span><span>])</span><br><span class="ͼg">def</span><span> </span><span class="ͼm">home</span><span>():</span><br><br><span>    </span><span class="ͼm">short_url</span><span> </span><span class="ͼg">=</span><span> </span><span class="ͼj">None</span><br><br><span>    </span><span class="ͼg">if</span><span> </span><span class="ͼm">request</span><span class="ͼg">.</span><span>method </span><span class="ͼg">==</span><span> </span><span class="ͼk">'POST'</span><span>:</span><br><br><span>        </span><span class="ͼm">long_url</span><span> </span><span class="ͼg">=</span><span> </span><span class="ͼm">request</span><span class="ͼg">.</span><span>form[</span><span class="ͼk">'long_url'</span><span>]</span><br><br><span>        </span><span class="ͼm">random_code</span><span> </span><span class="ͼg">=</span><span> </span><span class="ͼk">''</span><span class="ͼg">.</span><span>join(</span><span class="ͼm">random</span><span class="ͼg">.</span><span>choices(</span><span class="ͼm">string</span><span class="ͼg">.</span><span>ascii_letters </span><span class="ͼg">+</span><span> </span><span class="ͼm">string</span><span class="ͼg">.</span><span>digits, </span><span class="ͼm">k</span><span class="ͼg">=</span><span class="ͼj">6</span><span>))</span><br><br><span>        </span><span class="ͼm">short_url</span><span> </span><span class="ͼg">=</span><span> </span><span class="ͼk">f"http://127.0.0.1:5000/</span><span>{</span><span class="ͼm">random_code</span><span>}</span><span class="ͼk">"</span><br><br><span>        </span><span class="ͼm">url_mapping</span><span>[</span><span class="ͼm">random_code</span><span>] </span><span class="ͼg">=</span><span> </span><span class="ͼm">long_url</span><br><br><span>    </span><span class="ͼg">return</span><span> </span><span class="ͼm">render_template</span><span>(</span><span class="ͼk">'index.html'</span><span>, </span><span class="ͼm">short_url</span><span class="ͼg">=</span><span class="ͼm">short_url</span><span>)</span><br><br><span class="ͼf">@</span><span class="ͼm">app</span><span class="ͼg">.</span><span class="ͼm">route</span><span>(</span><span class="ͼk">'/&lt;code&gt;'</span><span>)</span><br><span class="ͼg">def</span><span> </span><span class="ͼm">redirect_url</span><span>(</span><span class="ͼm">code</span><span>):</span><br><br><span>    </span><span class="ͼm">long_url</span><span> </span><span class="ͼg">=</span><span> </span><span class="ͼm">url_mapping</span><span class="ͼg">.</span><span>get(</span><span class="ͼm">code</span><span>)</span><br><br><span>    </span><span class="ͼg">if</span><span> </span><span class="ͼm">long_url</span><span>:</span><br><span>        </span><span class="ͼg">from</span><span> </span><span class="ͼm">flask</span><span> </span><span class="ͼg">import</span><span> </span><span class="ͼm">redirect</span><br><span>        </span><span class="ͼg">return</span><span> </span><span class="ͼm">redirect</span><span>(</span><span class="ͼm">long_url</span><span>)</span><br><br><span>    </span><span class="ͼg">return</span><span> </span><span class="ͼk">"URL not found"</span><br><br><span class="ͼg">if</span><span> </span><span class="ͼm">__name__</span><span> </span><span class="ͼg">==</span><span> </span><span class="ͼk">'__main__'</span><span>:</span><br><span>    </span><span class="ͼm">app</span><span class="ͼg">.</span><span>run(</span><span class="ͼm">debug</span><span class="ͼg">=</span><span class="ͼj">True</span><span>)</span></code></pre></div></div></div></div></div></div></div></div></div><div class=""><div class="" style="width: 100%; transform: none;"></div></div></div></div></div></pre>
