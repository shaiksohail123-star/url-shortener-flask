><span class="ͼg">.</span><span>cursor()</span><br><br><span class="ͼm">cursor</span><span class="ͼg">.</span><span>execute(</span><span class="ͼk">'''</span><br><span class="ͼk">CREATE TABLE IF NOT EXISTS urls (</span><br><span class="ͼk">    id INTEGER PRIMARY KEY AUTOINCREMENT,</span><br><span class="ͼk">    long_url TEXT NOT NULL,</span><br><span class="ͼk">    short_code TEXT NOT NULL</span><br><span class="ͼk">)</span><br><span class="ͼk">'''</span><span>)</span><br><br><span class="ͼm">conn</span><span class="ͼg">.</span><span>commit()</span><br><span class="ͼm">conn</span><span class="ͼg">.</span><span>close()</span><br><br><br><span class="ͼf">@</span><span class="ͼm">app</span><span class="ͼg">.</span><span class="ͼm">route</span><span>(</span><span class="ͼk">'/'</span><span>, </span><span class="ͼm">methods</span><span class="ͼg">=</span><span>[</span><span class="ͼk">'GET'</span><span>, </span><span class="ͼk">'POST'</span><span>])</span><br><span class="ͼg">def</span><span> </span><span class="ͼm">home</span><span>():</span><br><br><span>    </span><span class="ͼm">short_url</span><span> </span><span class="ͼg">=</span><span> </span><span class="ͼj">None</span><br><br><span>    </span><span class="ͼm">conn</span><span> </span><span class="ͼg">=</span><span> </span><span class="ͼm">sqlite3</span><span class="ͼg">.</span><span>connect(</span><span class="ͼk">'database.db'</span><span>)</span><br><span>    </span><span class="ͼm">cursor</span><span> </span><span class="ͼg">=</span><span> </span><span class="ͼm">conn</span><span class="ͼg">.</span><span>cursor()</span><br><br><span>    </span><span class="ͼg">if</span><span> </span><span class="ͼm">request</span><span class="ͼg">.</span><span>method </span><span class="ͼg">==</span><span> </span><span class="ͼk">'POST'</span><span>:</span><br><br><span>        </span><span class="ͼm">long_url</span><span> </span><span class="ͼg">=</span><span> </span><span class="ͼm">request</span><span class="ͼg">.</span>